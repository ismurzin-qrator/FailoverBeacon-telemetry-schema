{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request event",
  "description": "One HTTP request of a call, as one line of an upload body. Null fields and empty lists are omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "call_id",
    "resend_count",
    "start_time",
    "elapsed_time",
    "sampling_fraction",
    "phase",
    "type",
    "reused_connection",
    "network"
  ],
  "properties": {
    "format_version": {
      "description": "Event format; equals the major version of this schema.",
      "const": 1
    },
    "call_id": {
      "description": "Random 64-bit ID of the call, as 16 lowercase hex digits.",
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "resend_count": {
      "description": "0 for the first request of the call.",
      "type": "integer",
      "minimum": 0
    },
    "start_time": {
      "description": "Request start, epoch milliseconds, device clock.",
      "type": "integer",
      "minimum": 0
    },
    "elapsed_time": {
      "description": "Request duration, milliseconds.",
      "type": "integer",
      "minimum": 0
    },
    "sampling_fraction": {
      "description": "The rate that kept the event; its weight is 1 / sampling_fraction.",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "scheme": {
      "enum": ["http", "https"]
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "phase": {
      "description": "NEL phase; follows from type.",
      "enum": ["dns", "connection", "application"]
    },
    "type": {
      "$ref": "#/$defs/error_type"
    },
    "step": {
      "description": "Where the request failed; absent if it did not.",
      "$ref": "#/$defs/step"
    },
    "status_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "protocol": {
      "description": "ALPN ID, such as http/1.1 or h2.",
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "server_ip": {
      "description": "The address connected to: the proxy's through an HTTP proxy, the server's name through SOCKS.",
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "proxy": {
      "$ref": "#/$defs/proxy"
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "cipher"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "cipher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "issuer": {
          "description": "Issuer of the server certificate, as a distinguished name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "reused_connection": {
      "type": "boolean"
    },
    "dns_addresses": {
      "description": "The DNS answer; the proxy's through an HTTP proxy, absent through SOCKS.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "timings": {
      "description": "Phase durations, milliseconds; a phase that did not happen is absent. connect includes tls.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "dns": { "$ref": "#/$defs/duration" },
        "connect": { "$ref": "#/$defs/duration" },
        "tls": { "$ref": "#/$defs/duration" },
        "send": { "$ref": "#/$defs/duration" },
        "wait": { "$ref": "#/$defs/duration" },
        "receive": { "$ref": "#/$defs/duration" }
      }
    },
    "request_body_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "response_content_length": {
      "description": "The Content-Length header as the server sent it.",
      "type": "integer"
    },
    "response_body_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "attempts": {
      "description": "Connection attempts in the order they started.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ip", "proxy", "result"],
        "properties": {
          "ip": {
            "description": "The proxy's address through an HTTP proxy, the server's name through SOCKS.",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "proxy": { "$ref": "#/$defs/proxy" },
          "elapsed_time": { "$ref": "#/$defs/duration" },
          "result": {
            "description": "canceled: the client stopped trying before the network answered.",
            "enum": ["connected", "failed", "canceled"]
          },
          "type": { "$ref": "#/$defs/error_type" },
          "step": { "$ref": "#/$defs/step" }
        },
        "if": {
          "properties": { "result": { "const": "failed" } }
        },
        "then": {
          "required": ["type", "step"]
        }
      }
    },
    "network": {
      "description": "The default network when the request started.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": ["connected", "none", "unknown"]
        },
        "transport": {
          "enum": ["wifi", "ethernet", "cellular", "bluetooth", "other"]
        },
        "vpn": { "type": "boolean" },
        "validated": { "type": "boolean" },
        "captive_portal": { "type": "boolean" },
        "metered": { "type": "boolean" },
        "roaming": {
          "description": "API 28+.",
          "type": "boolean"
        },
        "downstream_kbps": {
          "type": "integer",
          "minimum": 1
        },
        "upstream_kbps": {
          "type": "integer",
          "minimum": 1
        },
        "signal_strength": {
          "description": "API 29+.",
          "type": "integer"
        },
        "blocked": {
          "description": "Blocked for the app; API 29+.",
          "type": "boolean"
        },
        "carrier": {
          "description": "The SIM that carries data.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "mcc": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            },
            "mnc": {
              "type": "string",
              "minLength": 2,
              "maxLength": 3
            },
            "carrier_id": {
              "description": "API 28+.",
              "type": "integer",
              "minimum": 0
            },
            "network_type": {
              "description": "TelephonyManager NETWORK_TYPE_* of the data connection.",
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "if": {
        "properties": { "state": { "const": "connected" } }
      },
      "then": {
        "required": ["transport", "vpn", "validated", "captive_portal", "metered"]
      },
      "else": {
        "maxProperties": 1
      }
    },
    "foreground": {
      "description": "Whether an activity of the app was started.",
      "type": "boolean"
    },
    "failover": {
      "description": "What failover did for the request, absent when failover does not handle its host. on: the host is handled. dns_failed: a lookup returned failover's addresses while the host's last resolve had failed. retry: the request is failover's resend after an HTTP/2 timeout.",
      "enum": ["on", "dns_failed", "retry"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "pattern": "^dns\\." } }
      },
      "then": {
        "properties": { "phase": { "const": "dns" } }
      }
    },
    {
      "if": {
        "properties": { "type": { "pattern": "^(tcp|tls)\\." } }
      },
      "then": {
        "properties": { "phase": { "const": "connection" } }
      }
    },
    {
      "if": {
        "properties": { "type": { "pattern": "^(dns|tcp|tls)\\." } }
      },
      "else": {
        "properties": { "phase": { "const": "application" } }
      }
    }
  ],
  "$defs": {
    "duration": {
      "type": "integer",
      "minimum": 0
    },
    "error_type": {
      "description": "NEL network error types and Chromium's extensions.",
      "enum": [
        "ok",
        "http.error",
        "abandoned",
        "unknown",
        "dns.name_not_resolved",
        "dns.failed",
        "dns.timed_out",
        "tcp.timed_out",
        "tcp.closed",
        "tcp.reset",
        "tcp.refused",
        "tcp.aborted",
        "tcp.address_invalid",
        "tcp.address_unreachable",
        "tcp.failed",
        "tls.cert.authority_invalid",
        "tls.cert.name_invalid",
        "tls.cert.pinned_key_not_in_cert_chain",
        "tls.protocol.error",
        "tls.failed",
        "http.protocol.error",
        "http.response.invalid",
        "http.response.invalid.empty",
        "http.response.invalid.content_length_mismatch",
        "http.response.invalid.incomplete_chunked_encoding",
        "http.response.redirect_loop",
        "http.failed"
      ]
    },
    "step": {
      "enum": ["dns", "tcp", "tls", "request", "response"]
    },
    "proxy": {
      "enum": ["direct", "http", "socks"]
    }
  }
}
